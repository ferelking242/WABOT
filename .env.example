# ════════════════════════════════════════════════════════════════════
# wabot — Environment Configuration
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════════

# ── WhatsApp Bot ─────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER=242064235945       # Bot phone number (with country code, no +)
OWNER_NUMBER=242065491040                # Your personal number (bot owner)
BOT_NAME=wabot                          # Bot display name
THEME_EMOJI=•                           # Prefix emoji

# ── REST API ──────────────────────────────────────────────────────────
API_PORT=3001                           # API server port (default 3001)
API_CORS_ORIGIN=*                       # CORS origin (* = allow all)
PUBLIC_URL=                             # Your server public URL (auto-detected if empty)
                                        # e.g. https://mybot.example.com

# ── Auto-Updater (A/B deployment) ────────────────────────────────────
AUTO_UPDATE=true                        # Enable/disable auto-update (true/false)
GITHUB_OWNER=ferelking242               # GitHub repo owner
GITHUB_REPO=wabot                       # GitHub repo name
GITHUB_BRANCH=main                      # Branch to track
GITHUB_TOKEN=                           # GitHub Personal Access Token (optional, avoids rate limits)
GITHUB_WEBHOOK_SECRET=                  # Secret for GitHub push webhook HMAC verification

# ── Database / Supabase ───────────────────────────────────────────────
SUPABASE_URL=                           # https://xxxx.supabase.co
SUPABASE_KEY=                           # Supabase anon key
SUPABASE_SERVICE_KEY=                   # Supabase service role key

# ── AI / External APIs ────────────────────────────────────────────────
GROQ_API_KEY=                           # Groq API key (for AI commands)
GROQ_API_URL=https://api.groq.com/openai/v1

# ── Queue Settings ────────────────────────────────────────────────────
QUEUE_MIN_DELAY=800                     # Min ms between sent messages (anti-ban)
QUEUE_MAX_DELAY=2500                    # Max ms between sent messages

# ── Misc ──────────────────────────────────────────────────────────────
NODE_ENV=production                     # production | development
TZ=Africa/Brazzaville                   # Timezone
